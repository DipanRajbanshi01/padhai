# ---------------------------------------------------------------------------
# Padhai — environment variables. Copy to `.env` and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Database (Supabase Postgres) ---
# Pooled connection (PgBouncer, port 6543) used by the app at runtime.
# Supabase dashboard → Project Settings → Database → Connection string → "Transaction" pooler.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) used by Prisma Migrate. "Session"/direct string.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Supabase (Auth + Storage) ---
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-public-key>"
# Server-only. Never expose to the browser. Used for admin/service operations.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# --- App ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Auth: Google OAuth (configured in Supabase Auth providers) ---
# (Set the Google client id/secret inside the Supabase dashboard, not here.)

# --- SMS / OTP (phone OTP — wire later) ---
# e.g. Sparrow SMS. Left blank until a provider is chosen + credentialed.
SMS_PROVIDER=""
SMS_API_TOKEN=""
SMS_FROM=""

# --- Payments: eSewa (sandbox) ---
# Test merchant code + secret from eSewa epay-v2 sandbox.
ESEWA_MERCHANT_CODE="EPAYTEST"
ESEWA_SECRET_KEY="8gBm/:&EnhH.1/q"
ESEWA_BASE_URL="https://rc-epay.esewa.com.np" # sandbox; prod: https://epay.esewa.com.np

# --- Payments: Khalti (sandbox) ---
KHALTI_SECRET_KEY="<khalti-test-secret-key>"
KHALTI_BASE_URL="https://dev.khalti.com" # sandbox; prod: https://khalti.com
